# Copy to local.properties (never commit it).
sdk.dir=/path/to/Android/Sdk
# App key from https://developer.dji.com/user/apps  (package name must be com.drone3d.app)
DJI_API_KEY=put-your-dji-app-key-here
# Only for the :avata module (runs Python on the phone): a Python 3.10 on this computer, e.g.
# chaquopy.buildPython=C:/Users/me/AppData/Local/Programs/Python/Python310/python.exe
# chaquopy.buildPython=/usr/bin/python3.10
